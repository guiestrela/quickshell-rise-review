#!/usr/bin/env bash
# Add Rise through Omarchy's supported plugin manager, then install its AI usage
# collectors and user timers as part of the same setup command.
set -euo pipefail

PLUGIN_ID="io.github.guiestrela.quickshell-rise"
PLUGIN_REPO_URL="${RISE_PLUGIN_REPO_URL:-https://github.com/guiestrela/quickshell-rise-review.git}"
PLUGIN_DIR="${RISE_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/$PLUGIN_ID}"

fail() { printf 'install-rise: %s\n' "$*" >&2; exit 1; }

command -v omarchy >/dev/null 2>&1 || fail "Omarchy is required; install Rise with its supported plugin manager."

# When this script is launched as `curl ... | bash`, bash reads the installer
# from stdin. Omarchy's add command is interactive, so give it the controlling
# terminal instead of the exhausted script pipe. Keep Omarchy's confirmation
# prompt; users can decline activation and review the cloned plugin first.
if [[ ! -t 0 && -r /dev/tty ]]; then
  omarchy plugin add "$PLUGIN_REPO_URL" </dev/tty
else
  omarchy plugin add "$PLUGIN_REPO_URL"
fi

# Refresh the running shell's plugin registry before the user enables Rise.
omarchy-shell shell rescanPlugins || fail "Omarchy added Rise, but the shell could not rescan plugins. Run: omarchy-shell shell rescanPlugins"

[[ -d "$PLUGIN_DIR" ]] || fail "Omarchy added the plugin but its expected directory is missing: $PLUGIN_DIR"
[[ -x "$PLUGIN_DIR/scripts/install-ai-backends" ]] || fail "AI usage installer is missing or not executable in $PLUGIN_DIR"

"$PLUGIN_DIR/scripts/install-ai-backends" "$PLUGIN_DIR"
printf "Rise and its four AI usage collectors are installed. Enable the bar separately with: omarchy plugin enable %s\n" "$PLUGIN_ID"
