#!/usr/bin/env python3
"""Validated Hyprland display actions and non-destructive monitors.lua writer."""
import argparse
import json
import os
import re
import fcntl
import secrets
import stat
import time
import subprocess
import sys
from pathlib import Path

BEGIN = "-- BEGIN RISE DISPLAY MANAGER (AUTO-GENERATED)"
END = "-- END RISE DISPLAY MANAGER"
NAME = re.compile(r"^[A-Za-z0-9_.:-]{1,64}$")
MODE = re.compile(r"^(?:preferred|[1-9][0-9]{1,4}x[1-9][0-9]{1,4}(?:@[1-9][0-9]{0,2}(?:\.[0-9]{1,3})?)?)$")
SCALE = re.compile(r"^(?:[1-9](?:\.[0-9]{1,2})?|0\.[1-9][0-9]?)$")


def require_name(value, label="monitor"):
    if not isinstance(value, str) or not NAME.fullmatch(value):
        raise ValueError(f"Invalid {label} name")
    return value


def monitor_args(args):
    name = require_name(args.monitor)
    mode = str(args.mode).removesuffix("Hz")
    if not MODE.fullmatch(mode):
        raise ValueError("Invalid mode; expected preferred or WIDTHxHEIGHT[@HZ]")
    scale = args.scale
    if not SCALE.fullmatch(scale) or float(scale) > 4:
        raise ValueError("Invalid scale (expected 0.1–4)")
    if not 0 <= args.transform <= 7:
        raise ValueError("Invalid transform (expected 0–7)")
    if args.mirror != "none":
        require_name(args.mirror, "mirror target")
        if args.mirror == name:
            raise ValueError("A display cannot mirror itself")
    if not (-32768 <= args.x <= 32767 and -32768 <= args.y <= 32767):
        raise ValueError("Position outside supported bounds")
    return name, mode, scale


def run(argv, *, capture=False):
    return subprocess.run(argv, check=True, text=True, capture_output=capture, timeout=10)


def quote_lua(value):
    # Each field is validated before escaping; modes are not output names.
    if not isinstance(value, str) or not value.isascii() or any(ord(c) < 32 for c in value):
        raise ValueError("Invalid Lua string")
    return json.dumps(value)


def build_block(data):
    if not isinstance(data, dict) or not isinstance(data.get("monitors"), list):
        raise ValueError("Layout requires a monitors array")
    monitors = data["monitors"]
    if not monitors or len(monitors) > 32:
        raise ValueError("Layout must contain 1–32 monitors")
    lines = [BEGIN, "-- Managed by Rise Display Manager"]
    seen = set()
    if any(not isinstance(e, dict) for e in monitors):
        raise ValueError("Invalid monitor entry")
    independent = {require_name(e.get("output")) for e in monitors if not e.get("disabled", False) and not e.get("mirror")}
    if not independent:
        raise ValueError("Keep at least one independent display enabled")
    for entry in monitors:
        if not isinstance(entry, dict):
            raise ValueError("Invalid monitor entry")
        name = require_name(entry.get("output"))
        if name in seen:
            raise ValueError("Duplicate monitor name")
        seen.add(name)
        if not isinstance(entry.get("disabled", False), bool):
            raise ValueError("Invalid disabled state")
        if entry.get("disabled", False):
            lines.append(f"hl.monitor({{ output = {quote_lua(name)}, disabled = true }})")
            continue
        mode = entry.get("mode", "preferred")
        if isinstance(mode, str):
            mode = mode.removesuffix("Hz")
        if not isinstance(mode, str) or not MODE.fullmatch(mode):
            raise ValueError("Invalid monitor mode")
        position = entry.get("position", "auto")
        if position != "auto" and (not isinstance(position, str) or not re.fullmatch(r"-?\d{1,5}x-?\d{1,5}", position)):
            raise ValueError("Invalid monitor position")
        if position != "auto" and any(not -32768 <= int(c) <= 32767 for c in position.split("x")):
            raise ValueError("Position outside supported bounds")
        scale = entry.get("scale", 1)
        if isinstance(scale, bool) or not isinstance(scale, (int, float)) or not 0.1 <= scale <= 4:
            raise ValueError("Invalid monitor scale")
        transform = entry.get("transform", 0)
        if isinstance(transform, bool) or not isinstance(transform, int) or not 0 <= transform <= 7:
            raise ValueError("Invalid monitor transform")
        mirror = entry.get("mirror")
        if mirror and (require_name(mirror, "mirror target") not in independent or mirror == name):
            raise ValueError("Mirror target must be another independent active display")
        lines.extend([f"hl.monitor({{ output = {quote_lua(name)}, mode = {quote_lua(mode)}, position = {quote_lua(position)}, scale = {scale:g}, transform = {transform}," + (f" mirror = {quote_lua(require_name(mirror, 'mirror target'))}," if mirror else "") + " })"])
    lines.extend(['hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })'])
    if data.get("manageWorkspaces") is True:
        workspaces = data.get("workspaces", [])
        if not isinstance(workspaces, list) or len(workspaces) > 10:
            raise ValueError("Invalid workspace assignments")
        seen_workspaces = set()
        for ws in workspaces:
            if not isinstance(ws, dict) or isinstance(ws.get("workspace"), bool) or not isinstance(ws.get("workspace"), int) or not 1 <= ws["workspace"] <= 10 or ws["workspace"] in seen_workspaces:
                raise ValueError("Invalid workspace assignment")
            seen_workspaces.add(ws["workspace"])
            target = require_name(ws.get("monitor"))
            if target not in independent:
                raise ValueError("Workspace references unknown monitor")
        if workspaces:
            lines.extend(["hl.config({", "  workspace = {"])
            defaults = set()
            for ws in workspaces:
                lines.append(f'    "{ws["workspace"]}, monitor:{require_name(ws["monitor"])}' + (", default:true" if ws["monitor"] not in defaults else "") + '",')
                defaults.add(ws["monitor"])
            lines.extend(["  },", "})"])
    lines.append(END)
    return "\n".join(lines)


def read_existing(directory, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    except FileNotFoundError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 1048576:
            raise ValueError("Configuration must be a bounded regular file")
        with os.fdopen(fd, "rb", closefd=False) as stream:
            value = stream.read(1048577)
        if len(value) > 1048576:
            raise ValueError("Configuration too large")
        return value
    finally:
        os.close(fd)


def atomic_write(directory, name, value):
    temporary = ".rise-display-" + secrets.token_hex(12)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "wb", closefd=False) as stream:
            stream.write(value); stream.flush(); os.fsync(fd)
        os.rename(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    finally:
        os.close(fd)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def config_directory():
    directory = os.open(Path.home(), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for name in (".config", "hypr"):
            try:
                os.mkdir(name, 0o700, dir_fd=directory)
            except FileExistsError:
                pass
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory); directory = child
        return directory
    except BaseException:
        os.close(directory); raise


def save_layout(data, *, reload=False):
    block = build_block(data)
    if reload:
        values = normalize_monitors(json.loads(run(["hyprctl", "monitors", "all", "-j"], capture=True).stdout))
        if not isinstance(values, list) or any(not isinstance(m, dict) for m in values):
            raise ValueError("Invalid connected monitor state")
        connected = {require_name(m.get("name")) for m in values}
        planned = {entry["output"] for entry in data["monitors"] if not entry.get("disabled", False) and not entry.get("mirror")}
        if not (planned & connected):
            raise ValueError("Keep at least one connected independent display enabled")
        if any(entry["output"] not in connected for entry in data["monitors"]):
            raise ValueError("Layout contains a disconnected display; refresh first")
    directory = config_directory()
    lock = None
    try:
        lock = os.open(".rise-display-manager.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=directory)
        if not stat.S_ISREG(os.fstat(lock).st_mode):
            raise ValueError("Invalid save lock")
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = read_existing(directory, "monitors.lua")
        read_existing(directory, "monitors.lua.bak")
        old = original.decode("utf-8") if original is not None else ""
        if BEGIN in old or END in old:
            if old.count(BEGIN) != 1 or old.count(END) != 1 or old.index(END) < old.index(BEGIN):
                raise ValueError("Existing managed markers are ambiguous; file was not changed")
            new = old[:old.index(BEGIN)] + block + old[old.index(END) + len(END):]
        else:
            new = (old.rstrip() + "\n\n" if old else "") + block + "\n"
        encoded = new.encode()
        if len(encoded) > 1048576:
            raise ValueError("Resulting configuration too large")
        if read_existing(directory, "monitors.lua") != original:
            raise ValueError("Config changed during save; refresh first")
        if original is not None:
            atomic_write(directory, "monitors.lua.rise-backup-" + str(time.time_ns()), original)
            atomic_write(directory, "monitors.lua.bak", original)
        atomic_write(directory, "monitors.lua", encoded)
        if reload:
            try:
                run(["hyprctl", "reload"])
            except (OSError, subprocess.SubprocessError) as error:
                if read_existing(directory, "monitors.lua") != encoded:
                    raise ValueError("Reload failed and file changed externally; use versioned backup") from error
                if original is None:
                    os.unlink("monitors.lua", dir_fd=directory)
                else:
                    atomic_write(directory, "monitors.lua", original)
                raise ValueError("Reload failed; prior file restored. Check runtime state.") from error
    finally:
        if lock is not None:
            os.close(lock)
        os.close(directory)


def normalize_monitors(values):
    if not isinstance(values, list) or not 1 <= len(values) <= 32 or any(not isinstance(m, dict) for m in values):
        raise ValueError("Invalid monitor state")
    copies = [dict(m) for m in values]
    names = {require_name(m.get("name")) for m in copies}
    if len(names) != len(copies):
        raise ValueError("Duplicate monitor name")
    ids = {}
    for m in copies:
        if type(m.get("id")) is int:
            key = str(m['id'])
            if key in ids:
                raise ValueError("Duplicate monitor id")
            ids[key] = m['name']
    for m in copies:
        target = m.get('mirrorOf')
        if target in (None, '', 'none'):
            m['mirrorOf'] = 'none'
        elif isinstance(target, str) and target in names:
            m['mirrorOf'] = target
        elif type(target) in (int, str) and re.fullmatch(r'[0-9]{1,10}', str(target)) and str(target) in ids:
            m['mirrorOf'] = ids[str(target)]
        else:
            raise ValueError("Unknown mirror source in compositor state")
        if m['mirrorOf'] == m['name']:
            raise ValueError("A display cannot mirror itself")
    return copies


def check_live_action(name, mirror="none", *, disabling=False):
    values = normalize_monitors(json.loads(run(["hyprctl", "monitors", "all", "-j"], capture=True).stdout))
    if not isinstance(values, list) or len(values) > 32 or any(not isinstance(m, dict) for m in values):
        raise ValueError("Invalid monitor state")
    by_name = {require_name(m.get("name")): m for m in values}
    if name not in by_name:
        raise ValueError("Output is no longer connected; refresh first")
    independent = {n for n,m in by_name.items() if not m.get("disabled",False) and m.get("mirrorOf","none") in (None,"","none")}
    if disabling:
        if not (independent - {name}):
            raise ValueError("Keep at least one independent display enabled")
        if any(not m.get("disabled",False) and m.get("mirrorOf") == name for m in values):
            raise ValueError("Detach mirrors before disabling their source")
    elif mirror != "none":
        if any(not m.get("disabled", False) and m.get("mirrorOf") == name for m in values):
            raise ValueError("Detach existing mirrors before mirroring their source")
        if mirror == name or mirror not in independent:
            raise ValueError("Choose another independent active mirror target")


def read_brightness(name):
    text = run(["omarchy-brightness-display", "--no-osd", "--monitor", require_name(name)], capture=True).stdout.strip()
    if not re.fullmatch(r"[0-9]{1,3}", text) or not 0 <= int(text) <= 100:
        raise ValueError("Could not read brightness for " + name)
    return int(text)


def parser_for_action():
    parser = argparse.ArgumentParser()
    parser.add_argument("--action", required=True, choices=["monitors", "monitor", "disable", "save", "brightness", "brightness-state", "text-size"])
    parser.add_argument("--monitor")
    parser.add_argument("--mode", default="preferred")
    parser.add_argument("--x", type=int, default=0)
    parser.add_argument("--y", type=int, default=0)
    parser.add_argument("--scale", default="1")
    parser.add_argument("--transform", type=int, default=0)
    parser.add_argument("--mirror", default="none")
    parser.add_argument("--percent", type=int)
    parser.add_argument("--size", type=int)
    parser.add_argument("--payload")
    return parser


def main():
    args = parser_for_action().parse_args()
    try:
        if args.action == "monitors":
            result = run(["hyprctl", "monitors", "all", "-j"], capture=True)
            monitors = normalize_monitors(json.loads(result.stdout))
            if not isinstance(monitors, list) or len(monitors) > 32:
                raise ValueError("Invalid monitor response")
            for monitor in monitors:
                if not isinstance(monitor, dict):
                    raise ValueError("Invalid monitor response entry")
                require_name(monitor.get("name"))
                if "availableModes" in monitor and not isinstance(monitor["availableModes"], list):
                    raise ValueError("Invalid available modes")
            print(json.dumps(monitors, separators=(",", ":")))
        elif args.action in ("monitor", "disable"):
            if args.action == "disable":
                name = require_name(args.monitor)
                check_live_action(name, disabling=True)
                code = f"hl.monitor({{ output = {quote_lua(name)}, disabled = true }})"
            else:
                name, mode, scale = monitor_args(args)
                check_live_action(name, args.mirror)
                pos = f"{args.x}x{args.y}"
                code = (f"hl.monitor({{ output = {quote_lua(name)}, mode = {quote_lua(mode)}, "
                        f"position = {quote_lua(pos)}, scale = {scale}, transform = {args.transform}"
                        + (f", mirror = {quote_lua(require_name(args.mirror, 'mirror target'))}" if args.mirror != "none" else ", mirror = \"\"")
                        + " })")
            result = run(["hyprctl", "eval", code], capture=True)
            if str(result.stdout or "").strip() != "ok":
                raise ValueError("Hyprland rejected display action: " + str(result.stdout or "empty response").strip()[:2048])
            print("Display action applied")
        elif args.action == "save":
            if not args.payload or len(args.payload) > 65536:
                raise ValueError("Missing or oversized layout payload")
            data = json.loads(args.payload)
            save_layout(data, reload=True)
            print("Layout saved, backup created when a prior file existed, and Hyprland reloaded")
        elif args.action == "brightness-state":
            name = require_name(args.monitor)
            print(json.dumps({"monitor": name, "percent": read_brightness(name)}))
        elif args.action == "brightness":
            require_name(args.monitor)
            if args.percent is None or not 1 <= args.percent <= 100:
                raise ValueError("Brightness must be 1–100")
            run(["omarchy-brightness-display", "--no-osd", "--monitor", args.monitor, f"{args.percent}%"])
            actual = read_brightness(args.monitor)
            if actual != args.percent:
                raise ValueError(f"Brightness readback for {args.monitor}: requested {args.percent}%, got {actual}%")
            print("Brightness updated and verified")
        elif args.action == "text-size":
            if args.size not in (9, 10, 11, 12, 14, 16, 20):
                raise ValueError("Text size must match an offered preset")
            run(["omarchy-display-text-size", str(args.size)])
            print("Text size updated")
    except (ValueError, OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(f"Display Manager: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
