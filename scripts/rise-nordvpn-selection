#!/usr/bin/env python3
"""Read only technology/transport from NordVPN's local legacy Settings RPC.

Fallback for an upgraded CLI talking to a daemon that has not been restarted.
Wire schema: NordSecurity/nordvpn-linux, protobuf/daemon/settings.proto and
config/{technology,protocol}.proto. No setters, credentials or Internet calls.
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

MAX_REPLY = 65536

def _varint(data, pos):
    value = 0
    for shift in range(0, 70, 7):
        if pos >= len(data):
            raise ValueError('Truncated varint')
        byte = data[pos]
        pos += 1
        value |= (byte & 127) << shift
        if byte < 128:
            return value, pos
    raise ValueError('Oversized varint')

def _fields(data, wanted):
    pos, result = 0, {}
    while pos < len(data):
        tag, pos = _varint(data, pos)
        number, wire = tag >> 3, tag & 7
        if number == 0:
            raise ValueError('Invalid field')
        if wire == 0:
            value, pos = _varint(data, pos)
        elif wire == 2:
            size, pos = _varint(data, pos)
            value = data[pos:pos + size]
            pos += size
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            value = data[pos:pos + size]
            pos += size
        else:
            raise ValueError('Unsupported wire type')
        if pos > len(data):
            raise ValueError('Truncated field')
        if number in wanted:
            if number in result:
                raise ValueError('Duplicate selection field')
            result[number] = value
    return result

def decode_selection(body):
    if len(body) < 5 or len(body) > MAX_REPLY or body[0] != 0:
        raise ValueError('Invalid gRPC frame')
    size = int.from_bytes(body[1:5], 'big')
    if size != len(body) - 5:
        raise ValueError('Invalid gRPC frame size')
    response = _fields(body[5:], {1, 2})
    if response.get(1) != 1000 or not isinstance(response.get(2), bytes):
        raise ValueError('Settings read failed')
    settings = _fields(response[2], {1, 12})
    technologies = {1: 'OPENVPN', 2: 'NORDLYNX', 3: 'NORDWHISPER'}
    transports = {1: 'UDP', 2: 'TCP', 3: ''}
    technology = technologies.get(settings.get(1))
    protocol = transports.get(settings.get(12))
    if technology is None or protocol is None or (technology == 'OPENVPN' and not protocol):
        raise ValueError('Unknown selection')
    return {'schema': 1, 'technology': technology, 'protocol': protocol}

def read_selection(run=subprocess.run):
    parent = os.environ.get('TMPDIR') or os.environ.get('XDG_RUNTIME_DIR')
    if not parent:
        cache = Path.home() / '.cache' / 'quickshell-rise'
        cache.mkdir(parents=True, exist_ok=True, mode=0o700)
        parent = str(cache)
    with tempfile.TemporaryDirectory(prefix='nordvpn-selection-', dir=parent) as directory:
        headers = Path(directory) / 'headers'
        body = Path(directory) / 'reply'
        result = run([
            'curl', '-q', '--silent', '--show-error', '--noproxy', '*',
            '--http2-prior-knowledge', '--unix-socket', '/run/nordvpn/nordvpnd.sock',
            '--max-time', '3', '--max-filesize', str(MAX_REPLY),
            '--header', 'Content-Type: application/grpc', '--header', 'TE: trailers',
            '--data-binary', '@-', '--dump-header', str(headers), '--output', str(body),
            'http://localhost/pb.Daemon/Settings',
        ], input=b'\0' * 5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
        if result.returncode != 0 or not headers.is_file() or not body.is_file():
            raise ValueError('Local RPC unavailable')
        if headers.stat().st_size > MAX_REPLY or body.stat().st_size > MAX_REPLY:
            raise ValueError('Oversized response')
        text = headers.read_text(errors='replace')
        statuses = re.findall(r'^grpc-status:\s*(\d+)\s*$', text, re.M | re.I)
        if not re.search(r'^HTTP/\S+\s+200\b', text, re.M) or not statuses or statuses[-1] != '0':
            raise ValueError('Local RPC rejected')
        return decode_selection(body.read_bytes())

def main():
    if len(sys.argv) != 1:
        return 2
    try:
        result = read_selection()
    except (OSError, ValueError, subprocess.SubprocessError):
        print('NordVPN selection readback unavailable', file=sys.stderr)
        return 1
    print(json.dumps(result, separators=(',', ':')))
    return 0

if __name__ == '__main__':
    sys.exit(main())
