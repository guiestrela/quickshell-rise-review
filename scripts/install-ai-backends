#!/usr/bin/env bash
# Install all local usage collectors for the Rise AI usage widget.
# Usage: scripts/install-ai-backends [repository-root]
set -euo pipefail

src="${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
bindst="$HOME/.local/bin"
unitdst="$HOME/.config/systemd/user"

info() { printf '==> %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }

command -v python3 >/dev/null 2>&1 || {
  warn "python3 is required for the AI usage collectors."
  exit 1
}
command -v systemctl >/dev/null 2>&1 || {
  warn "systemctl is required to install and enable the AI usage timers. No collector files were changed."
  exit 1
}

for collector in claude-usage opencode-usage codex-usage copilot-usage; do
  [[ -f "$src/scripts/$collector" ]] || {
    warn "Required collector is missing: $src/scripts/$collector"
    exit 1
  }
done
for provider in claude opencode codex copilot; do
  for suffix in service timer; do
    [[ -f "$src/systemd/$provider-usage.$suffix" ]] || {
      warn "Required unit is missing: $src/systemd/$provider-usage.$suffix"
      exit 1
    }
  done
done

mkdir -p "$bindst" "$unitdst"

# Migrate away from the previous split Claude collectors, when present.
systemctl --user disable --now claude-usage-cookie.timer claude-usage-calc.timer >/dev/null 2>&1 || true
rm -f "$unitdst"/claude-usage-cookie.* "$unitdst"/claude-usage-calc.* \
      "$bindst"/claude-usage-cookie "$bindst"/claude-usage-calc

install -m 755 "$src/scripts/claude-usage" "$bindst/claude-usage"
install -m 644 "$src/systemd/claude-usage.service" "$unitdst/claude-usage.service"
install -m 644 "$src/systemd/claude-usage.timer" "$unitdst/claude-usage.timer"
install -m 755 "$src/scripts/codex-usage" "$bindst/codex-usage"
install -m 644 "$src/systemd/codex-usage.service" "$unitdst/codex-usage.service"
install -m 644 "$src/systemd/codex-usage.timer" "$unitdst/codex-usage.timer"

install -m 755 "$src/scripts/opencode-usage" "$bindst/opencode-usage"
install -m 644 "$src/systemd/opencode-usage.service" "$unitdst/opencode-usage.service"
install -m 644 "$src/systemd/opencode-usage.timer" "$unitdst/opencode-usage.timer"
info "OpenCode usage collector installed."

# Copilot's metered quota is the monthly premium-request allowance, read from the
# same /copilot_internal/user snapshot the CLI and the editors use.
install -m 755 "$src/scripts/copilot-usage" "$bindst/copilot-usage"
install -m 644 "$src/systemd/copilot-usage.service" "$unitdst/copilot-usage.service"
install -m 644 "$src/systemd/copilot-usage.timer" "$unitdst/copilot-usage.timer"

systemctl --user daemon-reload || {
  warn "Collector files were installed, but the user systemd manager could not reload units. Resolve systemd --user and rerun this installer."
  exit 1
}
for provider in claude opencode codex copilot; do
  systemctl --user enable --now "$provider-usage.timer" || {
    warn "$provider collector files are installed, but its timer could not be enabled. Resolve systemd --user and rerun this installer."
    exit 1
  }
done

info "All four AI usage collectors and timers are installed. No provider CLI, login, credential, or usage-data priming was required."
